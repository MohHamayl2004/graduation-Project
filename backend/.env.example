PORT=5000
MONGO_URI=your_mongodb_connection_string
MONGO_URI_STANDARD=your_optional_non_srv_mongodb_connection_string
JWT_SECRET=your_jwt_secret
MONGO_URI_TEST=your_test_database_connection_string_containing_test
NODE_ENV=development
# Set true only when serving the built ../dist frontend from this API.
SERVE_FRONTEND=false
# Local Visa simulation only; disabled automatically in production.
DEMO_PAYMENTS_ENABLED=true


# Internal AI tutor service (Nipras_Ai_Models: python -m rag.service)
AI_SERVICE_URL=http://127.0.0.1:8000
# Same value as NIPRAS_SERVICE_KEY in Nipras_Ai_Models/.env
AI_SERVICE_KEY=change-me
# A CPU-only machine needs minutes per answer; a GPU needs seconds.
AI_TIMEOUT_MS=240000
