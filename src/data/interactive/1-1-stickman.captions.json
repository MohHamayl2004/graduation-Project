[
 {
  "start": 0.231,
  "end": 2.82,
  "text": "هاد سامي سامي طالع برحلة على طريق جبلي"
 },
 {
  "start": 2.867,
  "end": 4.573,
  "text": "غريب وقبل ما يطلع"
 },
 {
  "start": 5.015,
  "end": 7.522,
  "text": "سأله أستاذه سؤال واحد"
 },
 {
  "start": 8.219,
  "end": 11.238,
  "text": "بأي معدل تغير ارتفاعك خلال الرحلة"
 },
 {
  "start": 11.563,
  "end": 13.815,
  "text": "سامي ضحك وقال سهلة"
 },
 {
  "start": 14.512,
  "end": 17.774,
  "text": "بس الطريق مش مستقيم أبدا فكيف بدنا"
 },
 {
  "start": 17.855,
  "end": 20.909,
  "text": "نعطي جواب واحد لطريق كله نزلات"
 },
 {
  "start": 20.955,
  "end": 23.707,
  "text": "وطلعات هاد بالزبط اللي اسمه"
 },
 {
  "start": 23.8,
  "end": 25.228,
  "text": "متوسط التغير"
 },
 {
  "start": 26.311,
  "end": 29.573,
  "text": "الطريق عنا هو منحنى الاقتران قاف من"
 },
 {
  "start": 29.62,
  "end": 32.998,
  "text": "سين بساوي سين تكعيب ناقص خمسة"
 },
 {
  "start": 33.056,
  "end": 34.983,
  "text": "سين زائد ثلاثة"
 },
 {
  "start": 35.68,
  "end": 38.641,
  "text": "سين هي المسافة الأفقية وقيمة"
 },
 {
  "start": 38.664,
  "end": 40.568,
  "text": "الاقتران هي الارتفاع"
 },
 {
  "start": 41.079,
  "end": 44.492,
  "text": "الرحلة بتبدأ لما سين تساوي سالب"
 },
 {
  "start": 44.515,
  "end": 45.026,
  "text": "واحد"
 },
 {
  "start": 45.537,
  "end": 48.532,
  "text": "وبتخلص لما سين تساوي اثنين"
 },
 {
  "start": 48.973,
  "end": 52.282,
  "text": "والمطلوب متوسط التغير بين هاتين"
 },
 {
  "start": 52.352,
  "end": 53.245,
  "text": "النقطتين"
 },
 {
  "start": 54.456,
  "end": 56.407,
  "text": "خلينا نمشي مع سامي"
 },
 {
  "start": 57.521,
  "end": 60.679,
  "text": "من أول خطوة الطريق بنزل نزلة"
 },
 {
  "start": 60.853,
  "end": 64.209,
  "text": "طويلة لحد ما يصير تحت الصفر وبعدين"
 },
 {
  "start": 64.244,
  "end": 67.459,
  "text": "بطلع مرة ثانية لحد نقطة النهاية"
 },
 {
  "start": 67.97,
  "end": 69.99,
  "text": "نزلة وبعدها طلعة"
 },
 {
  "start": 70.431,
  "end": 73.671,
  "text": "لو بدنا نحسب كل خطوة لحالها رح نتعب"
 },
 {
  "start": 73.996,
  "end": 77.154,
  "text": "بس متوسط التغير بيعطينا طريقة"
 },
 {
  "start": 77.595,
  "end": 78.268,
  "text": "أذكى"
 },
 {
  "start": 78.872,
  "end": 81.24,
  "text": "بنطلع ع البداية والنهاية بس"
 },
 {
  "start": 81.964,
  "end": 82.811,
  "text": "أول سؤال"
 },
 {
  "start": 83.507,
  "end": 86.537,
  "text": "قديش مشي سامي بالأفقي هاد اسمه"
 },
 {
  "start": 86.561,
  "end": 89.347,
  "text": "التغير في سين وبنكتبه دلتا سين"
 },
 {
  "start": 89.951,
  "end": 93.155,
  "text": "دلتا سين بتساوي سين اثنين ناقص"
 },
 {
  "start": 93.19,
  "end": 96.267,
  "text": "سين واحد يعني اثنين ناقص سالب"
 },
 {
  "start": 96.313,
  "end": 96.847,
  "text": "واحد"
 },
 {
  "start": 97.544,
  "end": 100.713,
  "text": "وطرح السالب جمع فبتصير اثنين زائد"
 },
 {
  "start": 100.748,
  "end": 104.196,
  "text": "واحد يعني ثلاثة سامي مشي ثلاث وحدات"
 },
 {
  "start": 104.231,
  "end": 104.777,
  "text": "لقدام"
 },
 {
  "start": 105.535,
  "end": 106.359,
  "text": "ثاني سؤال"
 },
 {
  "start": 107.172,
  "end": 109.506,
  "text": "قديش كان ارتفاع سامي بالبداية"
 },
 {
  "start": 109.947,
  "end": 111.665,
  "text": "وقديش صار بالنهاية"
 },
 {
  "start": 112.176,
  "end": 114.405,
  "text": "هون بنعوض بالاقتران"
 },
 {
  "start": 114.846,
  "end": 118.224,
  "text": "عند البداية سين بتساوي سالب واحد"
 },
 {
  "start": 118.607,
  "end": 121.533,
  "text": "سالب واحد تكعيب بيعطي سالب"
 },
 {
  "start": 121.626,
  "end": 122.195,
  "text": "واحد"
 },
 {
  "start": 122.636,
  "end": 125.852,
  "text": "ناقص خمسة ضرب سالب واحد بيعطي"
 },
 {
  "start": 125.945,
  "end": 127.094,
  "text": "زائد خمسة"
 },
 {
  "start": 127.791,
  "end": 131.077,
  "text": "وزائد ثلاثة يعني سالب واحد زائد"
 },
 {
  "start": 131.111,
  "end": 133.933,
  "text": "خمسة زائد ثلاثة بساوي سبعة"
 },
 {
  "start": 134.536,
  "end": 137.671,
  "text": "سامي بلش على ارتفاع سبعة وعند"
 },
 {
  "start": 137.694,
  "end": 141.189,
  "text": "النهاية سين بتساوي اثنين اثنين تكعيب"
 },
 {
  "start": 141.224,
  "end": 144.138,
  "text": "ثمانية ناقص عشرة زائد"
 },
 {
  "start": 144.161,
  "end": 146.309,
  "text": "ثلاثة بساوي واحد"
 },
 {
  "start": 146.75,
  "end": 149.13,
  "text": "يعني خلص على ارتفاع واحد"
 },
 {
  "start": 149.865,
  "end": 151.723,
  "text": "هلأ التغير في الارتفاع"
 },
 {
  "start": 152.326,
  "end": 155.194,
  "text": "وبنكتبه دلتا صاد بساوي قاف من"
 },
 {
  "start": 155.217,
  "end": 158.642,
  "text": "اثنين ناقص قاف من سالب واحد يعني"
 },
 {
  "start": 158.712,
  "end": 160.302,
  "text": "واحد ناقص سبعة"
 },
 {
  "start": 160.906,
  "end": 163.96,
  "text": "بساوي سالب ستة والإشارة السالبة مش"
 },
 {
  "start": 163.983,
  "end": 167.21,
  "text": "غلط معناها إنه سامي نزل"
 },
 {
  "start": 167.257,
  "end": 168.395,
  "text": "ست وحدات"
 },
 {
  "start": 169.42,
  "end": 172.59,
  "text": "وهلأ الخطوة الأخيرة متوسط التغير"
 },
 {
  "start": 172.613,
  "end": 175.608,
  "text": "بساوي دلتا صاد على دلتا سين"
 },
 {
  "start": 176.049,
  "end": 179.44,
  "text": "سالب ستة على ثلاثة بساوي سالب اثنين"
 },
 {
  "start": 179.881,
  "end": 183.073,
  "text": "وشو معنى سالب اثنين تخيلوا حبل"
 },
 {
  "start": 183.108,
  "end": 186.22,
  "text": "مشدود من نقطة البداية لنقطة"
 },
 {
  "start": 186.278,
  "end": 187.056,
  "text": "النهاية"
 },
 {
  "start": 187.868,
  "end": 190.701,
  "text": "هاد الحبل اسمه القاطع وميله هو"
 },
 {
  "start": 190.748,
  "end": 192.199,
  "text": "متوسط التغير"
 },
 {
  "start": 192.803,
  "end": 195.914,
  "text": "يعني بالمعدل كل ما سامي يمشي وحدة"
 },
 {
  "start": 195.961,
  "end": 198.085,
  "text": "لقدام بنزل وحدتين"
 },
 {
  "start": 199.296,
  "end": 202.303,
  "text": "وهون الفكرة الأهم صاحبة"
 },
 {
  "start": 202.686,
  "end": 204.904,
  "text": "سامي ليلى ما مشيت الطريق"
 },
 {
  "start": 205.508,
  "end": 208.666,
  "text": "نزلت على الحبل مباشرة بخط مستقيم"
 },
 {
  "start": 208.7,
  "end": 210.999,
  "text": "ووصلت لنفس نقطة النهاية"
 },
 {
  "start": 211.696,
  "end": 214.749,
  "text": "الطريقين مختلفين كتير بس متوسط"
 },
 {
  "start": 214.784,
  "end": 216.967,
  "text": "التغير إلهم نفس القيمة"
 },
 {
  "start": 217.408,
  "end": 218.569,
  "text": "سالب اثنين"
 },
 {
  "start": 219.265,
  "end": 222.458,
  "text": "لأنه متوسط التغير ما بيهتم باللي"
 },
 {
  "start": 222.516,
  "end": 225.813,
  "text": "صار بالنص بيهتم بس بالبداية والنهاية"
 },
 {
  "start": 227.465,
  "end": 228.232,
  "text": "الخلاصة"
 },
 {
  "start": 228.673,
  "end": 231.935,
  "text": "بثلاث خطوات احسب دلتا سين"
 },
 {
  "start": 232.446,
  "end": 235.905,
  "text": "احسب قيمة الاقتران عند البداية والنهاية"
 },
 {
  "start": 236.347,
  "end": 238.971,
  "text": "واطرحهم عشان تطلع دلتا صاد"
 },
 {
  "start": 239.412,
  "end": 242.001,
  "text": "واقسم دلتا صاد على دلتا سين"
 },
 {
  "start": 242.604,
  "end": 245.565,
  "text": "والإشارة بتحكيلك موجبة يعني"
 },
 {
  "start": 245.635,
  "end": 246.296,
  "text": "طلعنا"
 },
 {
  "start": 246.738,
  "end": 248.665,
  "text": "وسالبة يعني نزلنا"
 },
 {
  "start": 249.269,
  "end": 252.334,
  "text": "وهيك بتكون فهمت متوسط التغير"
 }
]
